# Nexus Analytics — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs.
# Ne jamais commiter le fichier .env (il est dans .gitignore).

# ─── Google Cloud Platform ────────────────────────────────────────────────────
GCS_BUCKET_NAME=<nom-du-bucket-gcs>
GCP_PROJECT_ID=<id-du-projet-gcp>
BQ_DATASET_RAW=raw

# ─── FastAPI ──────────────────────────────────────────────────────────────────
# Clé secrète pour l'authentification X-API-Key sur l'API.
NEXUS_API_KEY=<clé-secrète-à-générer>

# ─── Google Drive API ─────────────────────────────────────────────────────────
# Clé API pour accéder aux CSV Oracle's Elixir sur Google Drive.
API_KEY=<clé-api-google-drive>

# ─── Leaguepedia (Fandom Bot) ─────────────────────────────────────────────────
# Compte bot Fandom pour l'ingestion Leaguepedia Cargo API.
# Créer un bot sur : https://lol.fandom.com/wiki/Special:BotPasswords
FANDOM_BOT_NAME=<username>@<BotName>
FANDOM_BOT_PASSWORD=<mot-de-passe-bot>

# ─── Riot Games API ───────────────────────────────────────────────────────────
# Clé développeur Riot pour l'ingestion ranked (PUUIDs + match IDs).
# Obtenir une clé sur : https://developer.riotgames.com
RIOT_API=<RGAPI-xxxx>

# ─── Discord Webhook (optionnel) ─────────────────────────────────────────────
# URL du webhook Discord pour les notifications pipeline.
# Laisser vide pour désactiver les notifications.
DISCORD_WEBHOOK_URL=
