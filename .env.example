# ── Google Cloud Storage ─────────────────────────────────────────────────────
# Nom du bucket GCS qui reçoit toutes les couches (bronze/, silver/, gold/)
GCS_BUCKET_NAME=

# ── Riot API ─────────────────────────────────────────────────────────────────
# Clé d'API Riot Games (https://developer.riotgames.com)
RIOT_API=

# ── Leaguepedia (Fandom bot) ─────────────────────────────────────────────────
# Identifiants du compte bot Fandom pour l'API Cargo Leaguepedia.
# Format : username@BotName et le mot de passe généré sur Special:BotPasswords.
# Laisser vide = accès anonyme (quota très réduit, déconseillé en production).
FANDOM_BOT_NAME=
FANDOM_BOT_PASSWORD=

# ── Notifications Discord ─────────────────────────────────────────────────────
# URL du webhook Discord pour les alertes pipeline (laisser vide pour désactiver)
DISCORD_WEBHOOK_URL=

# ── BigQuery (Gold layer) ─────────────────────────────────────────────────────
# ID du projet GCP utilisé pour BigQuery (ex: nexus-analytics-prod-498107)
GCP_PROJECT_ID=
# Dataset BigQuery qui reçoit les tables Silver brutes (défaut: raw)
BQ_DATASET_RAW=raw

# ── Clé interne (héritage) ───────────────────────────────────────────────────
# Clé API générique utilisée par certains scripts utilitaires.
API_KEY=
